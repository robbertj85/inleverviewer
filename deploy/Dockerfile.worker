# Data worker: weekly fetch + generate (deploy/scheduler.py), replacing the
# "Update inleverpunten data" GitHub Action.
FROM python:3.12-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY *.py ./
COPY scripts/ scripts/
COPY deploy/scheduler.py deploy/analysis_stage.py deploy/
ENV TZ=Europe/Amsterdam PYTHONUNBUFFERED=1 \
    INLEVER_SITE_DIR=/srv/inlever/site \
    INLEVER_DATA_DIR=/srv/inlever/data
# Mount points owned by the runtime user: Docker seeds empty named volumes from these.
RUN useradd --uid 1000 --create-home worker \
 && mkdir -p /srv/inlever/site /srv/inlever/data \
 && chown -R worker:worker /srv/inlever
USER worker
CMD ["python", "deploy/scheduler.py", "serve"]
